# Optional. App works with all of these unset.
HIBP_API_KEY=
NUMVERIFY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# ABSTRACT_PHONE_API_KEY is unused until AbstractPhoneScanner is re-registered.
# ABSTRACT_PHONE_API_KEY=

# Set to 1 to run Sherlock against its full site list (slower).
SHERLOCK_FULL=
SHERLOCK_NSFW=

# Render free / small hosts: keep heavy social crawlers from running at once.
# Default 1. Raise to 2 on a larger instance. Lightweight modules stay parallel.
# HEAVY_SCANNER_CONCURRENCY=1

# Timeouts in seconds
HOLEHE_TIMEOUT=75
SHERLOCK_TIMEOUT=90
MAIGRET_TIMEOUT=100
# Ranked site slice (default 50 — small enough for Render free).
# MAIGRET_FULL=1 uses every enabled site.
# MAIGRET_TOP_SITES=50
# MAIGRET_MAX_CONNECTIONS=10
# MAIGRET_FULL=
# MAIGRET_NSFW=
# MAIGRET_PARSE=1
# MAIGRET_SITE_TIMEOUT=8

# How many derived handles Sherlock / Maigret / Socialscan try (1–3, default 2).
# Dotted email locals (lisa.m.fraleigh) try lisamfraleigh first.
# SOCIAL_USERNAME_CANDIDATES=2

# SpiderFoot open-source (https://github.com/smicallef/spiderfoot) — not HX.
# Prefer the dedicated runner (SPIDERFOOT_URL). Local in-process CLI is off
# unless SPIDERFOOT_ENABLED=1 AND sf.py is installed. URL+token is enough to
# enable remote mode — do not also turn on ENABLED on the free Render web box.
# Breach / dark-web modules are not enabled. Deep scans are a future optional.
SPIDERFOOT_ENABLED=0
# Render private runner: http://spiderfoot-runner:10000 (or public URL + token).
# SPIDERFOOT_URL=
# SPIDERFOOT_RUNNER_TOKEN=
SPIDERFOOT_TIMEOUT=75
# Leave empty to use the social/account allowlist. Set passive|footprint only
# if you accept a slower, broader module set (still no HX).
SPIDERFOOT_USECASE=
# Optional comma-separated module override. Default: sfp_accounts,sfp_gravatar,sfp_social,sfp_github
# SPIDERFOOT_MODULES=sfp_accounts,sfp_github
SPIDERFOOT_MODULES=
# Multiprocessing workers inside sf.py. Runner default is 8 (Starter).
# Keep 2 if you run the local in-process CLI on a small host.
# SPIDERFOOT_MAX_THREADS=8
# Local checkout path if you are not using the image bundle.
# SPIDERFOOT_HOME=/opt/spiderfoot
# SPIDERFOOT_PYTHON=/opt/spiderfoot/.venv/bin/python
# Account Finder (sfp_accounts) on the runner. Skip the 715-site WhatsMyName
# distrust sweep (default on) and cap sites so a username scan finishes
# inside ~90–120s instead of dying with USERNAME-only salvage.
# SPIDERFOOT_SKIP_DISTRUST=1
# SPIDERFOOT_ACCOUNTS_MAX_SITES=120
# SPIDERFOOT_ACCOUNTS_NSFW=0
# SPIDERFOOT_CACHE=/opt/spiderfoot/cache
# SPIDERFOOT_WMN_JSON=/opt/spiderfoot/data/wmn-data.json
