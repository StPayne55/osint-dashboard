# Optional. App works with all of these unset.
HIBP_API_KEY=
NUMVERIFY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# ABSTRACT_PHONE_API_KEY is unused until AbstractPhoneScanner is re-registered.
# ABSTRACT_PHONE_API_KEY=

# Set to 1 to run Sherlock against its full site list (slower).
SHERLOCK_FULL=
SHERLOCK_NSFW=

# Timeouts in seconds
HOLEHE_TIMEOUT=75
SHERLOCK_TIMEOUT=90
MAIGRET_TIMEOUT=100
# Ranked site slice (default 200). MAIGRET_FULL=1 uses every enabled site.
# MAIGRET_TOP_SITES=200
# MAIGRET_FULL=
# MAIGRET_NSFW=
# MAIGRET_PARSE=1
# MAIGRET_SITE_TIMEOUT=8

# SpiderFoot open-source (https://github.com/smicallef/spiderfoot) — not HX.
# Bundled in the Docker image at /opt/spiderfoot. Default on when sf.py exists.
# Scans are capped (social/account modules + SPIDERFOOT_TIMEOUT) so Render
# does not hang. Breach / dark-web modules are not enabled.
SPIDERFOOT_ENABLED=1
SPIDERFOOT_TIMEOUT=120
# Leave empty to use the social/account allowlist. Set passive|footprint only
# if you accept a slower, broader module set (still no HX).
SPIDERFOOT_USECASE=
# Optional comma-separated module override, e.g. sfp_accounts,sfp_github
SPIDERFOOT_MODULES=
# Local checkout path if you are not using the image bundle.
# SPIDERFOOT_HOME=/opt/spiderfoot
# SPIDERFOOT_PYTHON=/opt/spiderfoot/.venv/bin/python
