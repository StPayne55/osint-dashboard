# Optional. App works with all of these unset.
HIBP_API_KEY=
NUMVERIFY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# ABSTRACT_PHONE_API_KEY is unused until AbstractPhoneScanner is re-registered.
# ABSTRACT_PHONE_API_KEY=

# Set to 1 to run Sherlock against its full site list (slower).
SHERLOCK_FULL=
SHERLOCK_NSFW=

# Render free / small hosts: keep heavy social crawlers from running at once.
# Default 1. Raise to 2 on a larger instance. Lightweight modules stay parallel.
# HEAVY_SCANNER_CONCURRENCY=1

# Timeouts in seconds
HOLEHE_TIMEOUT=75
SHERLOCK_TIMEOUT=90
MAIGRET_TIMEOUT=100
# Ranked site slice (default 50 — small enough for Render free).
# MAIGRET_FULL=1 uses every enabled site.
# MAIGRET_TOP_SITES=50
# MAIGRET_MAX_CONNECTIONS=10
# MAIGRET_FULL=
# MAIGRET_NSFW=
# MAIGRET_PARSE=1
# MAIGRET_SITE_TIMEOUT=8

# How many derived handles Sherlock / Maigret / Socialscan try (1–3, default 2).
# Dotted email locals (lisa.m.fraleigh) try lisamfraleigh first.
# SOCIAL_USERNAME_CANDIDATES=2

# SpiderFoot open-source (https://github.com/smicallef/spiderfoot) — not HX.
# Bundled in the Docker image at /opt/spiderfoot. Off by default: it regularly
# times out on Render free. Enable on a larger box with SPIDERFOOT_ENABLED=1.
# Scans are capped (social/account modules + SPIDERFOOT_TIMEOUT).
# Breach / dark-web modules are not enabled.
SPIDERFOOT_ENABLED=0
SPIDERFOOT_TIMEOUT=75
# Leave empty to use the social/account allowlist. Set passive|footprint only
# if you accept a slower, broader module set (still no HX).
SPIDERFOOT_USECASE=
# Optional comma-separated module override, e.g. sfp_accounts,sfp_github
SPIDERFOOT_MODULES=
# Multiprocessing workers inside sf.py. Keep low on Render free (default 2).
# SPIDERFOOT_MAX_THREADS=2
# Local checkout path if you are not using the image bundle.
# SPIDERFOOT_HOME=/opt/spiderfoot
# SPIDERFOOT_PYTHON=/opt/spiderfoot/.venv/bin/python
